[app]

# (str) ऐप का टाइटल
title = Silpia App

# (str) पैकेज का नाम
package.name = silpia

# (str) पैकेज डोमेन (पैकैजिंग के लिए)
package.domain = org.silpia

# (list) शामिल की जाने वाली सोर्स फाइलें
source.include_exts = py,png,jpg,kv,atlas

# (list) मुख्य पाइथन फाइल (बिना एक्सटेंशन के)
source.main_ext = py

# (str) एप्लीकेशन वर्जन
version = 0.1

# (list) एप्लीकेशन की जरूरतें (Requirements)
requirements = python3,kivy

# (str) ओरिएंटेशन (portrait या landscape)
orientation = portrait

[buildozer]

# (int) लॉग लेवल (0 से 2 तक)
log_level = 2
